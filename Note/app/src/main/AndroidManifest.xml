<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">


        <activity
            android:name=".activities.MainActivity"
            android:theme="@android:style/Theme.Holo"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.andreaak.common.activitiesShared.FileChooserActivity"
            android:label="Choose Database File"
            android:theme="@android:style/Theme.Holo"
            android:exported="true">

            <intent-filter>
                <action android:name="com.andreaak.note.activitiesShared.FileChooserActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.andreaak.common.activitiesShared.DirectoryChooserActivity"
            android:label="Choose Download Directory"
            android:theme="@android:style/Theme.Holo"
            android:exported="true">
            <intent-filter>
                <action android:name="com.andreaak.note.activitiesShared.DirectoryChooserActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>
        <activity
            android:name=".activities.EntityChooserActivity"
            android:theme="@android:style/Theme.Holo"
            android:exported="true">
            <intent-filter>
                <action android:name="com.andreaak.note.activities.EntityChooserActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>
        <activity
            android:name=".activities.DriveActivity"
            android:theme="@android:style/Theme.Holo"
            android:exported="true">
            <intent-filter>
                <action android:name="com.andreaak.note.activities.DriveActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>
        <activity
            android:name=".activities.NoteHtmlActivity"
            android:theme="@android:style/Theme.Holo"
            android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />
                <action android:name="com.andreaak.note.activities.NoteHtmlActivity" />
            </intent-filter>

        </activity>
        <activity
            android:name=".activities.NoteFindActivity"
            android:label="Note"
            android:theme="@android:style/Theme.Holo"
            android:exported="true">
            <intent-filter>
                <action android:name="com.andreaak.note.activities.NoteFindActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>
        <activity
            android:name=".activities.SettingsActivity"
            android:label="Preferences"
            android:theme="@android:style/Theme.Holo"
            android:exported="true">
            <intent-filter>
                <action android:name="com.andreaak.note.activities.SettingsActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>
    </application>

</manifest>